{
  "name": "cockpit",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
  "productName": "Cockpit",
  "description": "Run Claude Code across several projects from one window, driven by a Kanban board.",
  "author": "Tino Muchenje",
  "scripts": {
    "dev": "node server.js",
    "build": "next build --webpack",
    "start": "cross-env NODE_ENV=production node server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "app": "npm run build && electron .",
    "app:dev": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "next": "16.2.11",
    "node-pty": "^1.1.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
